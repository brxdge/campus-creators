# Copy to .env for local dev, or set these in Railway → Variables.
# Never commit real values.

# Required — the passcode for /admin. Use something long and random.
ADMIN_PASSCODE=change-me-to-something-long

# Required in production — signs the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where uploads and the database live.
# On Railway, attach a Volume and set these to paths inside it,
# otherwise every redeploy wipes all uploaded files.
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# Max size per uploaded file, in MB
MAX_UPLOAD_MB=25

NODE_ENV=production
